# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Nenhum .env e versionado, nem o .env.local.example: ele chegou a ser
# rastreado com credenciais reais na copia de trabalho. As variaveis
# obrigatorias estao documentadas no README.
.env
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI cache
/supabase/.temp/

# arquivo gerado por concatenação das migrations (não versionar)
/supabase/reset_e_aplicar_tudo.sql

.token-optimizer/